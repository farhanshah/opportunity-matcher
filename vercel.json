{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/monitor.js": {
      "maxDuration": 60
    },
    "api/live-openings.js": {
      "maxDuration": 30
    },
    "api/vacancy-detail.js": {
      "maxDuration": 30
    },
    "api/specific-openings.js": {
      "maxDuration": 30
    },
    "api/undp-openings.js": {
      "maxDuration": 30
    },
    "api/wfp-openings.js": {
      "maxDuration": 30
    },
    "api/unops-openings.js": {
      "maxDuration": 30
    },
    "api/monitor-sources.js": {
      "maxDuration": 60
    },
    "api/discover.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/discover",
      "destination": "/index.html"
    },
    {
      "source": "/saved",
      "destination": "/index.html"
    },
    {
      "source": "/tracker",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/prepare",
      "destination": "/prepare.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "crons": [
    {
      "path": "/api/monitor",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/monitor-sources",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/discover",
      "schedule": "0 7 * * *"
    }
  ]
}
