{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/monitor.js": {
      "maxDuration": 60
    },
    "api/live-openings.js": {
      "maxDuration": 30
    },
    "api/vacancy-detail.js": {
      "maxDuration": 30
    },
    "api/specific-openings.js": {
      "maxDuration": 30
    },
    "api/undp-openings.js": {
      "maxDuration": 30
    },
    "api/wfp-openings.js": {
      "maxDuration": 30
    },
    "api/unops-openings.js": {
      "maxDuration": 30
    },
    "api/monitor-sources.js": {
      "maxDuration": 60
    },
    "api/discover.js": {
      "maxDuration": 60
    },
    "api/reverify.js": {
      "maxDuration": 60
    },
    "api/welcome-email.js": {
      "maxDuration": 60
    },
    "api/welcome-now.js": {
      "maxDuration": 30
    },
    "api/worldwide-discover.js": {
      "maxDuration": 60
    },
    "api/daily-discovery-email.js": {
      "maxDuration": 30
    },
    "api/verify-worldwide.js": {
      "maxDuration": 60
    },
    "api/uk-morning-discover.js": {
      "maxDuration": 60
    },
    "api/expand-providers.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/discover",
      "destination": "/index.html"
    },
    {
      "source": "/saved",
      "destination": "/index.html"
    },
    {
      "source": "/tracker",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/prepare",
      "destination": "/prepare.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "crons": [
    {
      "path": "/api/monitor",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/monitor-sources",
      "schedule": "0 5,11,17,23 * * *"
    },
    {
      "path": "/api/discover",
      "schedule": "*/15 6 * * *"
    },
    {
      "path": "/api/reverify",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/welcome-email",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/worldwide-discover",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/daily-discovery-email",
      "schedule": "10 8-12 * * *"
    },
    {
      "path": "/api/verify-worldwide",
      "schedule": "15 2,7,8,12,17 * * *"
    },
    {
      "path": "/api/uk-morning-discover",
      "schedule": "0 7,8 * * *"
    },
    {
      "path": "/api/expand-providers",
      "schedule": "20 1 * * *"
    }
  ]
}
